{
  "author": "gpunz",
  "authorUrl": "https://github.com/gpunz",
  "cloudEndpoint": "https://gpu.nz/mcp",
  "description": "MCP server for the gpu.nz GPU cloud: search GPUs and prices, estimate VRAM, rent, monitor and stop GPU servers from Claude, Cursor, Codex and other AI agents.",
  "homepage": "https://gpu.nz/en/docs/mcp",
  "identifier": "gpunz-gpunz-mcp",
  "name": "gpu.nz GPU cloud",
  "prompts": [],
  "resources": [],
  "tags": [
    "mcp",
    "model-context-protocol",
    "gpu",
    "gpu-cloud",
    "cloud-gpu",
    "rent-gpu",
    "llm",
    "comfyui",
    "ollama",
    "vllm",
    "ai-agents"
  ],
  "tools": [
    {
      "name": "list_gpu_models",
      "title": "List GPU models",
      "description": "GPU models available on gpu.nz right now with VRAM, class and the cheapest hourly price per GPU. Use it to pick a gpu_slug for search_offers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "min_vram_gb": {
            "description": "Only models with at least this much VRAM per GPU",
            "type": "number",
            "minimum": 0
          },
          "query": {
            "description": "Filter by name, e.g. \"4090\" or \"H100\"",
            "type": "string",
            "maxLength": 40
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "List GPU models",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "search_offers",
      "title": "Search GPU servers",
      "description": "Search rentable GPU servers (offers) with live prices. Returns the cheapest matches first unless `order` says otherwise. Each result has an offer id for create_instance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gpu": {
            "description": "GPU model slug(s), comma-separated, e.g. \"rtx-4090-24gb\" or \"h100-sxm-80gb,h100-pcie-80gb\" (see list_gpu_models)",
            "type": "string",
            "maxLength": 200
          },
          "num_gpus": {
            "description": "GPUs per server, comma-separated, e.g. \"1\" or \"2,4,8\"",
            "type": "string",
            "maxLength": 20
          },
          "min_vram_gb": {
            "description": "Minimum VRAM per GPU, GB",
            "type": "number",
            "minimum": 0
          },
          "max_price_rub_h": {
            "description": "Maximum price for the whole server, rubles per hour",
            "type": "number",
            "minimum": 0
          },
          "country": {
            "description": "ISO-2 country codes, comma-separated, e.g. \"DE,NL,FI\"",
            "type": "string",
            "maxLength": 60
          },
          "min_reliability": {
            "description": "Minimum host reliability, 0–1 (0.98 is a good bar)",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "verified": {
            "description": "Only verified datacenters",
            "type": "boolean"
          },
          "min_disk_gb": {
            "description": "Minimum disk the server can give, GB",
            "type": "number",
            "minimum": 0
          },
          "type": {
            "description": "on_demand (default) or interruptible (cheaper, can be preempted)",
            "type": "string",
            "enum": [
              "on_demand",
              "interruptible"
            ]
          },
          "order": {
            "description": "Sort: price (default), dlperf_per_price for value, reliability, vram, inet_down",
            "type": "string",
            "enum": [
              "price",
              "-price",
              "dlperf",
              "dlperf_per_price",
              "reliability",
              "vram",
              "inet_down"
            ]
          },
          "limit": {
            "description": "How many offers to return (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Search GPU servers",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_offer",
      "title": "Get one offer",
      "description": "Details and the current price of one offer by id (from search_offers).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Offer id"
          }
        },
        "required": [
          "offer_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Get one offer",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_templates",
      "title": "List templates",
      "description": "Ready environments a server can start with: ComfyUI, Stable Diffusion Forge, Ollama + Open WebUI, vLLM, Jupyter/PyTorch, Kohya, FluxGym, Unsloth, chats with preloaded models, plain Ubuntu + CUDA, or a custom Docker image. Pass `slug` as `template` to create_instance.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "List templates",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "estimate_vram",
      "title": "Estimate VRAM for an AI model",
      "description": "How much GPU memory an AI model needs (LLMs such as Qwen, DeepSeek, Llama, Gemma, GPT-OSS; image and video models such as FLUX, SDXL, Wan) at a given precision and context length, and which GPUs on gpu.nz fit it with their current price. Call without `model` to list the known models.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "description": "Model name or id, e.g. \"qwen3-32b\", \"Llama 3.3 70B\", \"flux.1-dev\"",
            "type": "string",
            "maxLength": 80
          },
          "precision": {
            "description": "Weights precision: \"fp16\", \"fp8\", \"q8\", \"q6\", \"q5\", \"q4\" (LLMs; default q4 for LLMs, fp16 for image models)",
            "type": "string",
            "maxLength": 20
          },
          "context_tokens": {
            "description": "LLM context length in tokens (default 8192)",
            "type": "integer",
            "minimum": 512,
            "maximum": 1048576
          },
          "concurrent_requests": {
            "description": "Parallel sequences sharing the GPU (default 1)",
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Estimate VRAM",
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_account",
      "title": "Account and balance",
      "description": "The signed-in account and its balance, hourly burn and runway. Needs a key with user:read and billing:read.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Account and balance",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_instances",
      "title": "List my servers",
      "description": "Your rented servers with status, GPU, price and SSH command. Needs instances:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "description": "active (default): servers that are not destroyed; all: include destroyed ones",
            "type": "string",
            "enum": [
              "active",
              "all"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "List my servers",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_instance",
      "title": "Get one server",
      "description": "Status, SSH command, app URLs (ComfyUI, Jupyter, chat…), price and cost so far of one server. The root password is left out unless include_password is true (your SSH keys are installed on every server).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Instance id"
          },
          "include_password": {
            "description": "Include the root SSH password",
            "type": "boolean"
          }
        },
        "required": [
          "instance_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Get one server",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "create_instance",
      "title": "Rent a GPU server",
      "description": "Rents the server of an offer and starts it with a template. Billing starts right away and runs every minute until you stop or destroy it. Confirm the price with the user first. Needs instances:write. The response has the instance id; poll get_instance until status is running (usually 1–5 minutes).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Offer id from search_offers"
          },
          "template": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Template slug from list_templates, e.g. \"comfyui\", \"ollama\", \"pytorch\", \"custom\""
          },
          "disk_gb": {
            "type": "integer",
            "minimum": 10,
            "maximum": 2000,
            "description": "Disk size, GB (use the template's recommended_disk_gb)"
          },
          "name": {
            "description": "A name for the server",
            "type": "string",
            "maxLength": 60
          },
          "type": {
            "description": "on_demand (default) or interruptible",
            "type": "string",
            "enum": [
              "on_demand",
              "interruptible"
            ]
          },
          "image": {
            "description": "Docker image, only with the custom template",
            "type": "string",
            "maxLength": 300
          },
          "ssh_key_ids": {
            "description": "SSH key ids to install (default: all of yours)",
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "idempotency_key": {
            "description": "Reuse the same value when retrying the same request, so a retry never rents twice",
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "offer_id",
          "template",
          "disk_gb"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Rent a GPU server",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "stop_instance",
      "title": "Stop a server",
      "description": "Stops a running server: the GPU is released and billing drops to the disk only. Data on the disk is kept and the server can be started again (the GPU may then be taken by someone else; gpu.nz finds a replacement when it is). Needs instances:write.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Instance id"
          }
        },
        "required": [
          "instance_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Stop a server",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "start_instance",
      "title": "Start a server",
      "description": "Starts a stopped server again; GPU billing resumes. Confirm with the user. Needs instances:write.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Instance id"
          }
        },
        "required": [
          "instance_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Start a server",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "destroy_instance",
      "title": "Destroy a server",
      "description": "Destroys a server and deletes its disk for good; billing stops completely. Irreversible: confirm with the user. Needs instances:write.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Instance id"
          }
        },
        "required": [
          "instance_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Destroy a server",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_instance_logs",
      "title": "Server logs",
      "description": "The last lines of a server's container log: boot progress, app start-up, errors. Needs instances:read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Instance id"
          },
          "tail": {
            "description": "How many last lines (default 200)",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "instance_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Server logs",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_ssh_keys",
      "title": "List SSH keys",
      "description": "SSH public keys on the account; they are installed on new servers. Needs user:read.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "List SSH keys",
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "add_ssh_key",
      "title": "Add an SSH key",
      "description": "Adds an SSH public key (a line from a .pub file) to the account. Needs user:write.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "public_key": {
            "type": "string",
            "minLength": 20,
            "maxLength": 16000,
            "description": "The public key line, e.g. ssh-ed25519 AAAA… you@laptop"
          },
          "name": {
            "description": "A name for the key",
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "public_key"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Add an SSH key",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "topup_link",
      "title": "Top-up link",
      "description": "A link to the balance top-up page (SBP, crypto) for the user to open in a browser; payments never happen through the API. Optionally pre-fills the amount.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "description": "Amount in the account currency (rubles by default)",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "language": {
            "description": "Page language (default ru)",
            "type": "string",
            "enum": [
              "ru",
              "en"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Top-up link",
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ],
  "version": "1.0.0"
}
